kbots:
  name: "kbots"
  log_level: info
  data_dir: ./data
  # Training-data collection (opt-in). Records each agent turn — assembled prompt,
  # final response, full tool-call trace, and outcome — to <path>/turns.jsonl, plus
  # 👍/👎 rewards to rewards.jsonl. Feeds scripts/export_training_data.py (nanoGPT
  # corpus + SFT/LoRA JSONL). Off by default: it stores full conversation content
  # locally (secrets are redacted). See docs/TRAINING.md.
  training_collection:
    enabled: false
    include_tool_trace: true
    # path: ./data/training   # defaults to <data_dir>/training
    # Machine labels for collected turns (weak — human 👍/👎 always wins at
    # export; see docs/TRAINING.md). Adapted from fable-method's judge (MIT).
    judge:
      enabled: false
      provider: claude_code   # judge with a competent model even for local-agent turns
      model: haiku
      interval_hours: 6
      max_turns_per_run: 50
      min_age_minutes: 60     # give humans first shot at reacting

connectors:
  discord:
    enabled: true
    presence: true            # show a "🛠 Working…" status (red dot) while an agent is busy
    # Bot-to-bot loop backstop: after this many consecutive bot-triggered turns
    # in a channel with no human message, the bot goes quiet — but the chain
    # self-heals after bot_chain_decay_seconds of quiet (no human needed), so
    # genuine paused-then-resumed agent collaboration recovers on its own.
    # bot_chain_limit: 12
    # bot_chain_decay_seconds: 300
    accounts:
      main:
        token_key: discord-token
      # Add more bots:
      # ops:
      #   token_key: secrets/ops-bot-token
  http:
    enabled: false
    port: 8080
  # Inbound event webhook — lets external systems (smart-home hubs, cron, CI)
  # trigger agent actions. Agents register triggers with create_trigger, which
  # returns a UNIQUE url + secret per registration: the hub POSTs to
  # http://host:port/event/<trigger_id> with that trigger's X-Webhook-Secret.
  # Kill all event-triggered inference instantly with `/admin triggers off`.
  webhook:
    enabled: false
    host: "127.0.0.1"        # localhost only by default; use "0.0.0.0" for LAN (secure it!)
    port: 8090

defaults:
  llm:
    provider: claude_code
    model: sonnet
    max_tokens: 4096
    # mcp_config: /path/to/mcp.yaml  # Optional: external MCP servers for all agents
    # Local models (optional): any agent can run on a local model instead of
    # Claude by setting `llm: {provider: local, model: qwen3.5:9b}` in agents.yaml.
    # Works with Ollama and LM Studio (same OpenAI-compatible API) — leave
    # base_url unset to auto-detect whichever is running. See docs/LOCAL_MODELS.md.
    local:
      model: qwen3.5:9b        # default local model (pick per your RAM — see docs)
      # base_url: http://localhost:11434/v1   # unset = probe Ollama, then LM Studio
      # api_key: ""            # only if your endpoint requires one
      timeout: 180
      auto_pull: true          # pull a missing model on first use (Ollama) instead of erroring
  session:
    max_history: 50
    summarize_after: 30
  memory:
    backend: sqlite
    semantic_search: false
    decay_enabled: false
    max_results: 10
    # Reward-based working memory: agents save lessons (remember_lesson) and
    # feedback (record_outcome / 👍👎). The reflector periodically consolidates
    # them into each agent's LESSONS.md, injected at session start.
    reflection:
      enabled: true
      model: haiku          # cheap model — reflection is a focused consolidation call
      interval_hours: 24    # per-agent cadence
      min_lessons: 3        # skip until an agent has at least this many lessons
    # Graph memory (optional): entity/relationship layer on LadybugDB, additive
    # to the sqlite backend. One shared graph for all agents; edges carry scope
    # (global / agent:<id> / group:<name>) like memories. Agents get the
    # memory_link / memory_related / memory_unlink / memory_graph_query /
    # memory_graph tools. Requires: uv sync --extra graph
    # NOTE macOS 14: that sync fails — ladybug ships no macOS 14 wheels and its
    # source build needs the macOS 15 SDK. Workaround (a 2-line patch + local
    # wheel via the overlay): roadmap/graph-memory-ladybugdb.md → "macOS 14"
    graph:
      enabled: false
      path: data/graph/memory.lbdb   # resolved against the repo root
      # extract: true        # reflector also mines memories into graph edges
      #                      # (one cheap LLM call per agent per reflection pass;
      #                      # backfills the existing store batch by batch, then
      #                      # keeps absorbing new memories; edge scope inherits
      #                      # the source memory's scope)
      # extract_batch: 60    # memories examined per pass

# Schedule oversight (optional): a dedicated channel where agents' scheduled
# tasks are posted. React ❌ on a card to cancel it; use /schedules for the full
# board. Leave channel empty to disable the board (scheduling still works).
# You can also just ask the main agent to set this up — it creates/points a
# channel and enables the board live (no restart) via the admin-only
# set_schedule_board tool, which overrides the value below.
schedules:
  channel: ""                # e.g. "YOUR_SCHEDULES_CHANNEL_ID"
  bot: ""                    # optional bot account to post as (default: first)

# Identity reconcile (optional): a Discord ACCOUNT is named in the developer
# portal and nothing reconciles that with agents.yaml, so a bot can keep the
# name it was registered under while its config calls it something else. Turn
# this on and, on boot, any agent whose account name disagrees with its
# display_name gets ONE turn to rename itself, set its avatar and greet its
# owner. A successful rename removes the trigger, so it does not repeat; a
# rename Discord refuses is retried at most twice, ever.
#
# OFF by default on purpose. Renaming a bot account is outward-facing and
# Discord allows only two username changes per hour, so an established fleet
# should opt in rather than discover it after a restart.
identity:
  reconcile_on_boot: false

# Goal workstreams (optional): long-running multi-agent collaborations. A goal
# gets its own auto-created Discord channel; participants (each with its own
# bot account) are routed there dynamically from data/goals.db — no agents.yaml
# edits, no restart. While a goal is actively worked, its turn_budget replaces
# the global bot_chain_limit in that channel; the repeat-message loop guard
# still applies. See ARCHITECTURE.md → Goal Workstreams.
goals:
  enabled: true
  create_tiers: [coordinator, privileged]  # tiers that may CREATE/advance goals
                                           # (any agent may propose, join, vote)
  category_id: ""            # Discord category for auto-created goal channels
  default_turn_budget: 30    # bot turns allowed between human check-ins
  objection_window_hours: 24 # voting window on pause/abandon proposals
  escalation_user: ""        # Discord user id mentioned when a goal blocks;
                             # default: first access=owner human in team.json
  alert_on_block: true       # also post blocked goals to security.alert_channel

# Loopback API for inter-agent calls (ask_agent / send_to_agent) from tool
# subprocesses. Zero-config: binds 127.0.0.1 on an ephemeral port with a
# per-boot token. Only set a port if a firewall needs a fixed one.
internal_api:
  port: 0                    # 0 = ephemeral

security:
  hitl:
    connector: discord
    enabled: true            # approval gate on/off; toggle live with /admin hitl
    channel: "YOUR_OPS_CHANNEL_ID"
    approvers: ["YOUR_DISCORD_USER_ID"]
    timeout: 1800
    fail_mode: closed
    poll_interval: 3
    gated_tools:
      - send_email
      - install_mcp
      # Add any tools that need human approval

  rate_limits:
    mode: log    # switch to 'enforce' when ready
    defaults:
      max_per_hour: 100

  compression:
    enabled: false           # compress agent context files to reduce input tokens
    level: standard          # lite (articles + filler) | standard (full compression)
    # memory_recall: false   # compress memories at injection time (requires core wiring)

  # Access control (STRONGLY RECOMMENDED). When present, tiers from config/team.json
  # decide who can message which agent and which tools they may trigger. Without
  # this block, ANY user who can post in a routed channel drives agents with their
  # full toolset (Bash included) — the engine logs a warning at startup.
  #
  # Enabling it is fail-closed: users NOT listed in team.json resolve to the
  # `unknown` tier and are ignored, so populate team.json (humans + access levels)
  # before turning this on. Users in `admin_users.discord` are always treated as
  # owner, so you can never lock yourself out. Uncomment to enable:
  # access_control:
  #   unknown_policy: deny          # deny | safe_only
  #   safe_tools:                   # usable by any known tier
  #     - memory_search
  #     - memory_semantic_search
  #     - web_search
  #     - team_get
  #     - team_list

# Browser janitor: agents drive one real Chrome (chrome_browser tool) and leave
# it running when a task ends — tabs with video keep burning CPU forever. After
# this many hours with no chrome_browser activity the janitor closes Chrome
# cleanly (profile/logins persist; the next task relaunches it). 0 disables.
browser:
  idle_quit_hours: 3
  # tick_seconds: 600

admin_users:
  discord: ["YOUR_DISCORD_USER_ID"]
